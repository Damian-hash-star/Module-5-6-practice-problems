tickets = int(input("Enter the number of concert tickets: "))

if tickets >= 25:
  price_per_ticket = 50
elif tickets >= 10:
  price_per_ticket = 60
elif tickets >= 5:
  price_per_ticket = 70
else:
  price_per_ticket = 75

total_cost = tickets * price_per_ticket

print("\nConcert Tickets Purchase")
print("Number of Tickets:", tickets)
print("Price Per Ticket: $", price_per_ticket)
print("Total Cost: $", total_cost)
